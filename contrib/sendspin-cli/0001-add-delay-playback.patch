From d856748732bae3859f6afd3afbf06f016af48e5c Mon Sep 17 00:00:00 2001
From: Emily <emily@bruckcode.de>
Date: Mon, 19 Oct 2026 21:50:33 +0200
Subject: [PATCH] Add --delay-playback to hold an endpoint back

--static-delay can only make a speaker play earlier. An endpoint that
sounds ahead of the rest of its group had no way to be held back, though
the library has always taken a signed PlayerRoleConfig::fixed_delay_us
(positive plays earlier, negative later).

--delay-playback <ms> (0-5000, config key delay-playback) passes its
value as a negative fixed_delay_us. It is fixed for the run: not
remembered and not settable by a server, unlike the static delay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cli.cpp        | 34 ++++++++++++++++++++++++++++++++++
 src/cli.h          |  5 +++++
 src/control.h      |  2 ++
 src/main.cpp       |  9 +++++++--
 tests/cli_test.cpp | 25 +++++++++++++++++++++++++
 5 files changed, 73 insertions(+), 2 deletions(-)

diff --git a/src/cli.cpp b/src/cli.cpp
index 2b9445c..c8bb649 100644
--- a/src/cli.cpp
+++ b/src/cli.cpp
@@ -66,6 +66,7 @@ enum LongOnly {
     OPT_MANUFACTURER,
     OPT_PRODUCT_NAME,
     OPT_AUDIO_FORMAT,
+    OPT_DELAY_PLAYBACK,
 };
 
 /// An option a config file may set: its key (the long flag name) and how diagnostics name it.
@@ -100,6 +101,7 @@ const std::vector<SettableOption>& settable_options() {
         {Opt::Manufacturer, "manufacturer", "--manufacturer"},
         {Opt::ProductName, "product-name", "--product-name"},
         {Opt::AudioFormat, "audio-format", "--audio-format"},
+        {Opt::DelayPlayback, "delay-playback", "--delay-playback"},
     };
     return table;
 }
@@ -183,6 +185,19 @@ bool parse_static_delay(const std::string& str, uint16_t& delay_ms) {
     return true;
 }
 
+/// Parses a playback delay in milliseconds: digits only, 0 to MAX_DELAY_PLAYBACK_MS.
+bool parse_delay_playback(const std::string& str, uint16_t& delay_ms) {
+    if (!is_all_digits(str)) {
+        return false;
+    }
+    const unsigned long value = std::strtoul(str.c_str(), nullptr, 10);
+    if (value > MAX_DELAY_PLAYBACK_MS) {
+        return false;
+    }
+    delay_ms = static_cast<uint16_t>(value);
+    return true;
+}
+
 /// Names the option getopt complained about: optopt for a short one, the argv word for a long one.
 std::string offending_option(char* const argv[], int index) {
     const char* word = argv[index - 1];
@@ -323,6 +338,13 @@ bool apply_option(const SettableOption& option, const std::string& value, Option
                 return false;
             }
             break;
+        case Opt::DelayPlayback:
+            if (!parse_delay_playback(value, out.delay_playback_ms)) {
+                error = "invalid --delay-playback '" + value + "' -- expected 0-" +
+                        std::to_string(MAX_DELAY_PLAYBACK_MS);
+                return false;
+            }
+            break;
         case Opt::MdnsName:
             if (empty_value()) {
                 return false;
@@ -522,6 +544,7 @@ bool parse_options(int argc, char* argv[], Options& out, std::FILE* err) {
         {"port", required_argument, nullptr, OPT_PORT},
         {"buffer-ms", required_argument, nullptr, OPT_BUFFER_MS},
         {"static-delay", required_argument, nullptr, OPT_STATIC_DELAY},
+        {"delay-playback", required_argument, nullptr, OPT_DELAY_PLAYBACK},
         {"no-mdns", no_argument, nullptr, OPT_NO_MDNS},
         {"mdns-name", required_argument, nullptr, OPT_MDNS_NAME},
         {"control-socket", required_argument, nullptr, OPT_CONTROL_SOCKET},
@@ -644,6 +667,9 @@ bool parse_options(int argc, char* argv[], Options& out, std::FILE* err) {
             case OPT_STATIC_DELAY:
                 apply(Opt::StaticDelay, optarg);
                 break;
+            case OPT_DELAY_PLAYBACK:
+                apply(Opt::DelayPlayback, optarg);
+                break;
             case OPT_NO_MDNS:
                 apply(Opt::NoMdns, "true");
                 break;
@@ -804,6 +830,7 @@ bool parse_options(int argc, char* argv[], Options& out, std::FILE* err) {
             Opt::Logfile,   Opt::LogLevel,     Opt::BufferMs,    Opt::NoMdns,      Opt::MdnsName,
             Opt::NoControl, Opt::StateDir,     Opt::StaticDelay, Opt::HookStart,   Opt::HookStop,
             Opt::ClientId,  Opt::Manufacturer, Opt::ProductName, Opt::AudioFormat,
+            Opt::DelayPlayback,
         };
         for (Opt opt : DAEMON_ONLY) {
             if (out.was_given(opt)) {
@@ -978,6 +1005,13 @@ void print_usage(std::FILE* out, const char* prog) {
     std::fprintf(out, "                A FIRST-RUN DEFAULT only: a delay a server or\n");
     std::fprintf(out, "                'sendspin-cli delay' has set is remembered, and the\n");
     std::fprintf(out, "                remembered one wins over this flag every run after.\n");
+    std::fprintf(out, "  --delay-playback <ms>\n");
+    std::fprintf(out, "                Play this much LATER than the stream says, 0-%u,\n",
+                 MAX_DELAY_PLAYBACK_MS);
+    std::fprintf(out, "                default 0 -- the counterpart of --static-delay, which\n");
+    std::fprintf(out, "                can only make this speaker play earlier. For an endpoint\n");
+    std::fprintf(out, "                that sounds ahead of the rest of the group. Fixed: not\n");
+    std::fprintf(out, "                remembered, not settable by a server.\n");
     std::fprintf(out, "                Use 'delay <ms>' to change a running player\n");
     std::fprintf(out, "  --no-mdns     Do not advertise over mDNS (no effect with -s, which\n");
     std::fprintf(out, "                already suppresses it)\n");
diff --git a/src/cli.h b/src/cli.h
index 9fa5584..66cdf43 100644
--- a/src/cli.h
+++ b/src/cli.h
@@ -80,6 +80,7 @@ enum class Opt : unsigned {
     Manufacturer,   ///< --manufacturer
     ProductName,    ///< --product-name
     AudioFormat,    ///< --audio-format
+    DelayPlayback,  ///< --delay-playback
 };
 
 /// Everything the flag surface configures.
@@ -110,6 +111,10 @@ struct Options {
     /// A first-run default: a persisted delay wins.
     uint16_t static_delay_ms{0};
 
+    /// --delay-playback <ms>: play this much later than the stream's timestamps, 0 to
+    /// MAX_DELAY_PLAYBACK_MS. The counterpart of --static-delay, which only plays earlier.
+    uint16_t delay_playback_ms{0};
+
     /// --no-mdns: do not advertise `_sendspin._tcp`.
     bool no_mdns{false};
 
diff --git a/src/control.h b/src/control.h
index bd6864f..6aa8b73 100644
--- a/src/control.h
+++ b/src/control.h
@@ -49,6 +49,8 @@ inline constexpr int64_t CONTROL_IDLE_TIMEOUT_MS = 5000;
 
 /// Spec bound for static delay; sendspin-cpp silently clamps past it, so refuse at parse time.
 inline constexpr uint16_t MAX_STATIC_DELAY_MS = 5000;
+/// Upper bound for --delay-playback, matching the static delay's range.
+inline constexpr uint16_t MAX_DELAY_PLAYBACK_MS = 5000;
 
 /// Every request a subcommand can make: controller@v1 commands plus the locally answered two.
 enum class ControlCommand : uint8_t {
diff --git a/src/main.cpp b/src/main.cpp
index f864522..6213ce3 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -628,8 +628,13 @@ int main(int argc, char* argv[]) {
 
     sendspin::PlayerRoleConfig player_config;
     player_config.audio_formats = std::move(formats);
-    // Must stay 0: both sinks' timestamps already include their buffering.
-    player_config.fixed_delay_us = 0;
+    // 0 unless asked: the sinks' timestamps already include their buffering. A positive
+    // fixed_delay_us plays earlier, so --delay-playback goes in negated.
+    player_config.fixed_delay_us = -static_cast<int32_t>(opts.delay_playback_ms) * 1000;
+    if (opts.delay_playback_ms > 0) {
+        log_line(LogLevel::INFO, LOG_TAG_AUDIO, "Holding playback back by %u ms",
+                 static_cast<unsigned>(opts.delay_playback_ms));
+    }
     // extra_startup_silence_ms stays at the library default until measured on hardware.
 
     // A first-run default: a persisted delay wins. Set before add_player() loads it.
diff --git a/tests/cli_test.cpp b/tests/cli_test.cpp
index 7da50dd..15806de 100644
--- a/tests/cli_test.cpp
+++ b/tests/cli_test.cpp
@@ -388,6 +388,31 @@ TEST(ParseOptions, StaticDelayBounds) {
     }
 }
 
+TEST(ParseOptions, DelayPlaybackIsAccepted) {
+    Parse parse({"--delay-playback", "300"});
+
+    ASSERT_TRUE(parse.ok()) << parse.diagnostics();
+    EXPECT_EQ(parse.options().delay_playback_ms, 300U);
+    EXPECT_TRUE(parse.options().was_given(Opt::DelayPlayback));
+}
+
+TEST(ParseOptions, DelayPlaybackDefaultsToNone) {
+    Parse parse({});
+
+    ASSERT_TRUE(parse.ok()) << parse.diagnostics();
+    EXPECT_EQ(parse.options().delay_playback_ms, 0U);
+    EXPECT_FALSE(parse.options().was_given(Opt::DelayPlayback));
+}
+
+TEST(ParseOptions, DelayPlaybackBounds) {
+    for (const std::string value : {"-1", "5001", "abc", "", "+300"}) {
+        Parse parse({"--delay-playback", value});
+
+        EXPECT_FALSE(parse.ok()) << "--delay-playback accepted '" << value << "'";
+    }
+    EXPECT_TRUE(Parse({"--delay-playback", "5000"}).ok());
+}
+
 TEST(ParseOptions, StaticDelayNeedsAValue) {
     Parse parse({"--static-delay"});
 
-- 
2.54.0.windows.1

